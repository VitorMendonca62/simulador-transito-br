{
  "name": "simulador-transito",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:core": "wasm-pack build core --target web --release --out-dir pkg",
    "build:core:dev": "wasm-pack build core --target web --dev --out-dir pkg",
    "sample": "node scripts/gen-sample.mjs",
    "dev": "vite",
    "build": "npm run build:core && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "cargo test --manifest-path core/Cargo.toml"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "pixi.js": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
